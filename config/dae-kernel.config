# DAE (eBPF transparent proxy) kernel parameters for GL-MT6000
# Append to: target/linux/mediatek/filogic/config-6.18
# These are absent from upstream OpenWrt filogic config and required for DAE to function.

# cgroups + BPF cgroup attachment
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y

# kprobes + tracing (required for BPF_EVENTS)
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# BPF stream parser (required for sockmap/sk_skb programs)
CONFIG_BPF_STREAM_PARSER=y

# TC ingress/egress + BPF classifier + actions (required for DAE redirect)
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y

# BTF (BPF Type Format) — required for CO-RE and DAE kernel reflection
# Requires pahole >= 1.16 (dwarves package in CI)
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_DWARF5=y
