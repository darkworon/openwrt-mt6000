# DAE (eBPF transparent proxy) kernel parameters for GL-MT6000
# Append to: target/linux/mediatek/filogic/config-6.18
# Only raw Linux kernel options without OpenWrt CONFIG_KERNEL_* wrappers live here.
# Most DAE requirements are requested from the normal OpenWrt diffconfig.

# BPF stream parser (required for sockmap/sk_skb programs)
CONFIG_BPF_STREAM_PARSER=y

# Netkit device support avoids dae falling back to veth on kernels that support it.
CONFIG_NETKIT=y

# Linux 6.18 asks for this new scheduler option when NET_SCHED is enabled.
# dae does not need the BPF qdisc; keep kernel syncconfig non-interactive.
# CONFIG_NET_SCH_BPF is not set
