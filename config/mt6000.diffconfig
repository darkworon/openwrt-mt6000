# GL-MT6000 (MediaTek MT7986A, Filogic 830)
# Base: openwrt/openwrt main
# Custom patches in patches/kernel/ and patches/mt76/

# Target
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt6000=y

# DAE / eBPF kernel requirements
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_NETKIT=y
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# pesa1234 optimizations (via patches/kernel/)
CONFIG_RPS=y
CONFIG_NET_MEDIATEK_SOC_WED=y

# DAE package
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_luci-app-dae=y

# AdGuard Home
CONFIG_PACKAGE_adguardhome=y

# Zerotier
CONFIG_PACKAGE_zerotier=y

# Tools
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
